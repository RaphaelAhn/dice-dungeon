{
  "name": "dough-dungeon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sim": "esbuild tools/sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim.mjs --log-level=error && node node_modules/.cache/sim.mjs",
    "probe": "esbuild tools/probe.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/probe.mjs --log-level=error && node node_modules/.cache/probe.mjs",
    "check": "esbuild tools/check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check.mjs --log-level=error && node node_modules/.cache/check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "galmuri": "^2.40.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
